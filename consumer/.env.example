PORT=3002
HOST=127.0.0.1
SERVICE_NAME=consumer
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=telegramify.notifications
RABBITMQ_PREFETCH=1
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_MS=1000
CONSUMER_AUTO_START=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org
# Optional comma-separated chat ids added to broadcast recipients.
TELEGRAM_BROADCAST_CHAT_IDS=
